# ═══════════════════════════════════════════════════════════════
#  Payment Reliability Agent System — Environment Variables
#  Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ─── API Access (local development) ───────────────────────────
APP_ENV=development
API_AUTH_TOKEN=
TRUSTED_IDENTITY_HEADER=X-Authenticated-User
REQUIRE_GATEWAY_AUTH=false
ENABLE_SYNTHETIC_HEARTBEAT=false

# ─── In-VPC LLM (no external model providers) ────────────────
# Any OpenAI-compatible server you host inside the VPC (vLLM, Ollama, TGI). No API keys leave the network.
LLM_BASE_URL=http://localhost:8001/v1
LLM_API_KEY=not-needed
DEFAULT_MODEL=llama-3.1-70b-instruct
JUDGE_MODEL=qwen2.5-72b-instruct
# Judge must be from a different provider than every agent model (checked deterministically by name).
# Declare unrecognised models as pattern=provider pairs:
# MODEL_PROVIDER_MAP=my-finetune=meta
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# ─── Egress harness (fail closed) ─────────────────────────────
# Private ranges are always allowed. Everything else needs an explicit entry.
EGRESS_ENFORCE=true
EGRESS_ALLOWED_HOSTS=
EGRESS_ALLOWED_CIDRS=

# ─── Auto-remediation (non-critical only; critical is RCA-only) ──
AUTO_REMEDIATION_ENABLED=false
AUTO_ACTION_ALLOWLIST=restart_unhealthy_pod,scale_replicas,clear_cache
AUTO_ACTION_TARGET_SERVICES=
AUTO_ACTION_MAX_PER_HOUR=3
DUPLICATE_WINDOW_MINUTES=60

# ─── Tracing: keep it in-VPC (self-hosted Langfuse). Do NOT enable hosted LangSmith. ──
LANGCHAIN_TRACING_V2=false

# ─── Data & Infrastructure ────────────────────────────────────
# PostgreSQL (local or cloud)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agent_kb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here

# Supabase (Cloud Alternative)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Redis
REDIS_URL=redis://localhost:6379/0

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081

# ─── Observability & Monitoring ────────────────────────────────
# Langchain (for LangSmith tracing)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGCHAIN_PROJECT=anomaly-agent

# Langfuse (for LLM observability)
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
LANGFUSE_HOST=http://localhost:3001

# ─── Third-Party Integrations ──────────────────────────────────
# Slack (Recommended: Use Channel IDs instead of names)
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx-xxxxxxxxxxxx-xxxxxxxxxxxx
SLACK_ALERT_CHANNEL=C0XXXXXXX   # Channel ID for alerts
SLACK_APPROVAL_CHANNEL=C0YYYYYY # Channel ID for approvals

# PagerDuty
PAGERDUTY_API_KEY=xxxxxxxxxxxxxxxxxxxx
PAGERDUTY_SERVICE_ID=XXXXXXX

# N8n
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Grafana (Use modern Service Account tokens)
GRAFANA_URL=http://localhost:3000
GRAFANA_API_KEY=glsa_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Prometheus ──────────────────────────────────────────────
PROMETHEUS_URL=http://localhost:9090

GRAFANA_API_KEY=your-grafana-api-key

# ─── OpenTelemetry ───────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=anomaly-response-agent

# ─── Agent Configuration ─────────────────────────────────────
ANOMALY_CONFIDENCE_THRESHOLD=0.75
MAX_TOKENS_PER_INCIDENT=50000
MONITORING_AGENT_MODEL=gpt-4o-mini
DIAGNOSIS_AGENT_MODEL=gpt-4o
ACTION_AGENT_MODEL=gpt-4o
FEEDBACK_AGENT_MODEL=gpt-4o-mini

# ─── Application ─────────────────────────────────────────────
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Combined live ingestion (off by default; dry-run by default)
# Preferred: configure this from the dashboard at /connectors. Pick connectors
# (Prometheus / Datadog / Splunk), enter and test credentials, then activate.
# The selection builds CONNECTOR_MODES at runtime and is persisted (with
# credentials, plaintext) to .connector_state.json (gitignored; override path
# with CONNECTOR_STATE_PATH). It overrides the env values below once saved.
# Dashboard env: NEXT_PUBLIC_API_BASE (default http://localhost:8050/api/v1),
# NEXT_PUBLIC_API_KEY (sent as X-API-Key when API_AUTH_TOKEN is set).
# Env-only alternative:
# CONNECTOR_MODES=prometheus,datadog,splunk
# ENABLE_LIVE_INGESTION=true
# INGESTION_SERVICES=checkout,payments
# INGESTION_DRY_RUN=true
# PROMETHEUS_BEARER_TOKEN=
# TELEMETRY_QUERY_TEMPLATES={"prometheus":{"error_rate":"sum(rate(http_requests_total{service=\"{entity}\",status=~\"5..\"}[5m]))"}}
