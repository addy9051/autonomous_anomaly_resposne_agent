# ═══════════════════════════════════════════════════════════════════════════════
# AUTONOMOUS SRE INTELLIGENCE SAAS — ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

APP_ENV=production
API_TITLE="Autonomous SRE Intelligence SaaS"

# ─────────────────────────────────────────────────────────────────────────────
# 1. DATABASE CONFIGURATION (PostgreSQL 15+ with pgvector)
# ─────────────────────────────────────────────────────────────────────────────
# Cheapest / Easiest options:
# - Neon.tech (Free Tier: 0.5 GB storage, serverless, scales to 0, native pgvector)
# - Supabase.com (Free Tier: 500 MB DB with pgvector)
# - Local Docker Compose: postgresql://postgres:local_dev_password@localhost:5432/agent_kb
DATABASE_URL=postgresql://postgres:local_dev_password@localhost:5432/agent_kb

# ─────────────────────────────────────────────────────────────────────────────
# 2. ENCRYPTION MASTER KEY (Customer Secrets Security)
# ─────────────────────────────────────────────────────────────────────────────
# Used to encrypt customer Datadog API keys and Prometheus credentials with AES-128-CBC Fernet.
# Generate a new random key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_MASTER_KEY=e24zOHRzNHRyeHh5cndxOG5qNnVyMGV0cG1iN3Jpd3g=

# ─────────────────────────────────────────────────────────────────────────────
# 3. SERVERLESS PAY-PER-TOKEN LLM INFERENCE (Zero Idle Cost)
# ─────────────────────────────────────────────────────────────────────────────
# Choose ONE of the following providers:
#
# OPTION A: OpenAI (Recommended default)
# Get key: https://platform.openai.com/api-keys
# Cost: ~$0.15 / 1M input tokens (~$0.002 per incident)
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-proj-YOUR_OPENAI_API_KEY_HERE
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# OPTION B: OpenRouter (Ultra-cheap models like DeepSeek-V3 or Gemini 2.0 Flash)
# Get key: https://openrouter.ai/keys
# Cost: DeepSeek-V3 is ~$0.14 / 1M tokens
# LLM_PROVIDER=openrouter
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-YOUR_OPENROUTER_KEY_HERE
# LLM_MODEL=deepseek/deepseek-chat
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-proj-YOUR_OPENAI_API_KEY_HERE
# EMBEDDING_MODEL=text-embedding-3-small

# ─────────────────────────────────────────────────────────────────────────────
# 4. GOVERNANCE & AUTONOMY SETTINGS
# ─────────────────────────────────────────────────────────────────────────────
# Set to 'true' to permit Tier 1 allowlisted actions to execute without human approval
AUTO_REMEDIATION_ENABLED=false
# Maximum auto-remediation actions allowed per service per hour (circuit breaker)
AUTO_ACTION_MAX_PER_HOUR=5
# Allowlisted reversible actions
AUTO_ACTION_ALLOWLIST=restart_unhealthy_pod,scale_replicas,clear_cache

# ─────────────────────────────────────────────────────────────────────────────
# 5. OBSERVABILITY & TRACING (Optional Free Tier)
# ─────────────────────────────────────────────────────────────────────────────
# Get free account (50,000 traces/mo): https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ─────────────────────────────────────────────────────────────────────────────
# 6. CORS (Dashboard URL)
# ─────────────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,https://*.vercel.app
